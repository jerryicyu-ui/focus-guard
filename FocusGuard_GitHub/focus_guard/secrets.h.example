// 複製成 secrets.h 後填入自己的 Wi-Fi，secrets.h 不要上傳或放進繳交檔
// 開放式網路（沒有密碼）把 WIFI_PASS 設成 ""
#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// 選用：熱點不發 IP（序列埠出現 DHCP timeout）時，改用固定 IP
// iPhone 熱點網段是 172.20.10.x，閘道 172.20.10.1，遮罩 255.255.255.240
// #define WIFI_STATIC_IP 172, 20, 10, 13
// #define WIFI_GATEWAY   172, 20, 10, 1
